# Required for the Reading Assistant's AI features (vocabulary, summary,
# further-reading suggestions) AND the CMS's AI SEO Assistant / AI Writing
# Assistance. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — defaults to a fast, inexpensive model. Any current Claude
# model string works (see https://docs.claude.com for the current list).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# CMS database. Defaults to a local SQLite file — no setup required.
# To use Postgres instead, set e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/buraaqtimes"
# and change the `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign CMS session JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-string

# Absolute site URL, used to build canonical/OG links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (registration verification, password reset, notifications) ---
# If SMTP_HOST is unset, emails are logged to the console instead of sent —
# handy for local dev without a real mail provider. In dev, verification/
# reset links are also returned directly in the API response so you can
# test the flow without any email setup at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Buraaq Times <no-reply@buraaqtimes.example>"

# --- Distributed rate limiting (optional) ---
# If both are set, rate limits use Upstash Redis (works across multiple
# serverless instances). If unset, falls back to an in-memory limiter that
# only works correctly on a single instance — fine for dev, not for a
# multi-instance production deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
